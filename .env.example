# .env.example — скопируйте в .env и заполните

BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

ADMIN_EMAIL=
ADMIN_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

HEADLESS=true
LOG_LEVEL=info

# ─── TestRail ───
TESTRAIL_URL=https://INSTANCE.testrail.io
TESTRAIL_USER=you@email.com
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1
# Tip: в single-suite режиме TestRail сам назначает suite_id (часто 7,
# а не 1). Проверь: curl /api/v2/get_suites/<project_id> → "id"

# ─── Jira (баг-трекер, остаётся) ───
JIRA_URL=https://theromed.atlassian.net
JIRA_BUG_PROJECT=KAN
